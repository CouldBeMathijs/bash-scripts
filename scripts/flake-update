#!/usr/bin/env sh

# Define the default path
DEFAULT_PATH="$HOME/.dotfiles"

# Set the FLAKE_DIR
if [ -z "$1" ]; then
    FLAKE_DIR="$DEFAULT_PATH"
else
    FLAKE_DIR="$1"
fi

FLAKE_LOCK="$FLAKE_DIR/flake.lock"

# Check if the provided path is a directory
if [ ! -d "$FLAKE_DIR" ]; then
    echo "Error: Directory '$FLAKE_DIR' not found."
    exit 1
fi

# Check if flake.lock exists in the directory
if [ ! -f "$FLAKE_LOCK" ]; then
    echo "Error: 'flake.lock' not found in '$FLAKE_DIR'. Is this a Nix flake repository?"
    exit 1
fi

echo "--- Updating Nix Flake in $FLAKE_DIR ---"
echo

# Save the pre-pull state of flake.lock using a portable mktemp
TEMP_LOCK=$(mktemp 2>/dev/null || mktemp -t 'flk')
if [ -z "$TEMP_LOCK" ]; then
    echo "Error: Could not create temporary file."
    exit 1
fi

cp "$FLAKE_LOCK" "$TEMP_LOCK"

# Run git pull
PULL_OUTPUT=$(cd "$FLAKE_DIR" && git pull 2>&1)
PULL_STATUS=$?

if [ "$PULL_STATUS" -ne 0 ]; then
    rm -f "$TEMP_LOCK"
    case "$PULL_OUTPUT" in
        *Could\ not\ resolve*|*Network\ is\ unreachable*|*Connection\ timed\ out*|*Could\ not\ read\ from\ remote*|*ssh:*)
            echo "Error: No internet connection or remote host unreachable."
            ;;
        *)
            echo "Error: Git pull failed in $FLAKE_DIR:"
            echo "$PULL_OUTPUT"
            ;;
    esac
    exit 1
else
    echo "$PULL_OUTPUT"
fi

sleep 0.1

# Check for changes in flake.lock
if ! diff -q "$TEMP_LOCK" "$FLAKE_LOCK" >/dev/null 2>&1; then
    echo
    echo "--- Updated Repositories ---"
    echo " --"
    jq -r --argjson old "$(cat "$TEMP_LOCK")" \
      '.nodes | to_entries[] | select(.key != "root" and .value != $old.nodes[.key]) | .key' \
      "$FLAKE_LOCK" | sed 's/^/    /'
    echo " --"
    echo
fi

# Clean up the temporary file
rm -f "$TEMP_LOCK"

